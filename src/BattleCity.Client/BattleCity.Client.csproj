<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>BattleCity.Client</RootNamespace>
    <AssemblyName>BattleCity.Client</AssemblyName>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.2.1105" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.2.1105" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BattleCity.Core\BattleCity.Core.csproj" />
    <ProjectReference Include="..\BattleCity.Shared\BattleCity.Shared.csproj" />
    <!-- Embedded local host for "Play Online (Local Server)" — friend hosting still uses Server.Host. -->
    <ProjectReference Include="..\BattleCity.Server\BattleCity.Server.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(EnableMGCBItems)' != 'false'">
    <MonoGameContentReference Include="Content\Content.mgcb" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Content\Data\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Content\Data\%(Filename)%(Extension)</Link>
    </None>
    <None Include="Content\Audio\*.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Content\Audio\%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <Target Name="RestoreDotnetTools" BeforeTargets="CollectPackageReferences">
    <Message Text="Restoring dotnet tools" Importance="High" />
    <Exec Command="dotnet tool restore" WorkingDirectory="$(RepoRoot)" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(RepoRoot)tools\Restore-Mgcb.ps1&quot;" />
  </Target>

</Project>
